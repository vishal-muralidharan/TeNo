rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function isMember(data) {
      return isSignedIn() && (request.auth.uid in data.memberUids);
    }
    
    function getRole(labelData) {
      let rawRole = labelData.members[request.auth.uid];
      return (rawRole is string) ? rawRole : rawRole.role;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true; 
    }

    function getLabel(labelId) {
      return get(/databases/$(database)/documents/labels/$(labelId)).data;
    }

    // --- SYSTEM PATHS ---
    match /system_config/flags {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- USER PROFILE ---
    match /users/{userId} {
      allow read, create: if isOwner(userId);
      allow update: if isOwner(userId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'isAdmin', 'words_left', 'words_used', 'max_words']));
      allow delete: if false;
      
      // Kept old subcollections for transition/backup (e.g. saved_links)
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- UNIFIED SCHEMA: LABELS ---
    match /labels/{labelId} {
      allow read, update, delete: if isMember(resource.data);
      allow create: if isOwner(request.resource.data.ownerId) && isMember(request.resource.data);
    }

    // --- UNIFIED SCHEMA: LINKS ---
    match /links/{linkId} {
      allow read, update, delete: if isMember(resource.data);
      allow create: if isOwner(request.resource.data.ownerId) && isMember(request.resource.data);
    }
  }
}
