rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Checks membership using the memberUids array (new schema) OR
    // the members map (old schema) for backwards compatibility.
    function isMember(data) {
      return isSignedIn() && (
        (data.get('memberUids', [])).hasAny([request.auth.uid]) ||
        (data.get('members', {}).get(request.auth.uid, null) != null)
      );
    }

    // Returns true when the requesting user has an owner or editor role
    // in the given data's members map.
    function canWrite(data) {
      return isSignedIn() && isMember(data) && (
        data.get('members', {}).get(request.auth.uid, {}).get('role', '') in ['owner', 'editor'] ||
        data.get('members', {}).get(request.auth.uid, '') in ['owner', 'editor']
      );
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ─── SYSTEM PATHS ────────────────────────────────────────────────────────
    match /system_config/feature_flags {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── USER PROFILE ────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, create: if isOwner(userId);
      allow update: if isOwner(userId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'isAdmin', 'words_left', 'words_used', 'max_words']));
      allow delete: if false;

      // Private subcollections — blanket owner rule (cart_items, reminders,
      // saved_links, settings kept here for transition / private-only data)
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── UNIFIED SCHEMA: LABELS ──────────────────────────────────────────────
    // A label doc may be type 'links' | 'cart' | 'reminders'.
    // Read: any member (memberUids array-contains or members map).
    // Create: owner creating their own label.
    // Update: any member can update (covers ShareModal role changes, isShared toggle).
    //         Sensitive fields (ownerId, type) should only be changed by owner — enforced
    //         server-side in the joinLabel API function; Firestore rules keep it simple.
    // Delete: owner only.
    match /labels/{labelId} {
      allow read: if isMember(resource.data);
      allow create: if isOwner(request.resource.data.ownerId) && isMember(request.resource.data);
      allow update: if isMember(resource.data);
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ─── UNIFIED SCHEMA: LINKS ───────────────────────────────────────────────
    // Root-level links collection. Used by both the private default label
    // (memberUids: [uid]) and shared labels.
    match /links/{linkId} {
      allow read: if isMember(resource.data);
      allow create: if isOwner(request.resource.data.ownerId) && isMember(request.resource.data);
      allow update: if isMember(resource.data);
      allow delete: if isMember(resource.data);
    }

    // ─── UNIFIED SCHEMA: CART ITEMS (root) ──────────────────────────────────
    // Root-level cart_items only created for shared labels.
    // Private cart items remain in users/{uid}/cart_items subcollection.
    match /cart_items/{itemId} {
      allow read: if isMember(resource.data);
      allow create: if isOwner(request.resource.data.ownerId) && isMember(request.resource.data);
      allow update: if isMember(resource.data);
      allow delete: if isMember(resource.data);
    }

    // ─── UNIFIED SCHEMA: REMINDERS (root) ───────────────────────────────────
    // Root-level reminders only created for shared labels.
    // Private reminders remain in users/{uid}/reminders subcollection.
    match /reminders/{reminderId} {
      allow read: if isMember(resource.data);
      allow create: if isOwner(request.resource.data.ownerId) && isMember(request.resource.data);
      allow update: if isMember(resource.data);
      allow delete: if isMember(resource.data);
    }

    // ─── OLD SCHEMA: SHARED LABELS & LINKS (kept for rollback safety) ────────
    match /shared_labels/{labelId} {
      allow read, update, delete: if isMember(resource.data);
      allow create: if isOwner(request.resource.data.ownerId) && isMember(request.resource.data);
    }

    match /shared_links/{linkId} {
      allow read, update, delete: if isMember(resource.data);
      allow create: if isOwner(request.resource.data.ownerId) && isMember(request.resource.data);
    }
  }
}
